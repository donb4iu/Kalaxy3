        "allocated",
        "estimated",
        "inferred"
    ],
    "required_observability_windows": [
        "baseline",
        "immediate",
        "stabilization",
        "trend",
        "economic"
    ],
    "required_process_metrics": [
        "commands_executed",
        "commands_failed",
        "commands_retried",
