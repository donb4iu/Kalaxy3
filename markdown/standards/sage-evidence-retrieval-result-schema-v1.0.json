{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalaxy3.local/schemas/sage-evidence-retrieval-result-schema-v1.0.json",
  "title": "Kalaxy3 SAGE evidence retrieval result",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_version",
    "request",
    "policy_sha256",
    "sources",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array"
    },
    "results": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
