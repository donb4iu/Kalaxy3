{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markdown/standards/sage-e2e-zero-trust-runtime-receipt-schema-v1.0.json",
  "title": "Kalaxy3 SAGE zero-trust E2E runtime receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "hostname",
    "captured_at",
    "actor_role",
    "checks",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "sage-e2e-zero-trust-runtime-receipt"
    },
    "status": {
      "const": "pass"
    },
    "hostname": {
      "type": "string",
      "minLength": 3
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "const": "architect"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_ready",
        "origin_through_traefik_ready",
        "tunnel_ready",
        "metrics_monitor_configured",
        "unauthenticated_access_denied",
        "authorized_mfa_access_verified",
        "privileged_surfaces_not_published"
      ],
      "properties": {
        "workload_ready": {
          "const": true
        },
        "origin_through_traefik_ready": {
          "const": true
        },
        "tunnel_ready": {
          "const": true
        },
        "metrics_monitor_configured": {
          "const": true
        },
        "unauthenticated_access_denied": {
          "const": true
        },
        "authorized_mfa_access_verified": {
          "const": true
        },
        "privileged_surfaces_not_published": {
          "const": true
        }
      }
    },
    "evidence": {
      "type": "object"
    }
  }
}
