{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sage-human-participation-projection-schema-v1.0.json",
  "title": "SAGE Human Participation Projection",
  "type": "object",
  "required": [
    "schema_version",
    "projection_type",
    "source_commit",
    "source_objective",
    "questions",
    "epistemic_context",
    "provenance_issues"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "projection_type": {"const": "human-participation-attention"},
    "source_commit": {"type": "string", "minLength": 1},
    "source_objective": {"type": "string", "minLength": 1},
    "questions": {
      "type": "object",
      "required": [
        "what_should_i_care_about",
        "where_do_you_need_me",
        "where_should_we_spend_next_unit_of_effort"
      ],
      "additionalProperties": false,
      "properties": {
        "what_should_i_care_about": {"$ref": "#/$defs/items"},
        "where_do_you_need_me": {"$ref": "#/$defs/items"},
        "where_should_we_spend_next_unit_of_effort": {
          "$ref": "#/$defs/items"
        }
      }
    },
    "epistemic_context": {"type": "object"},
    "provenance_issues": {"type": "array"},
    "runtime_evidence_inventory": {"type": "object"}
  },
  "$defs": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epistemic_status", "source_refs"],
        "properties": {
          "epistemic_status": {"type": "string"},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          }
        }
      }
    }
  }
}
