  "panels": [
    {
      "datasource_uid": "prometheus",
      "family": "cluster",
      "id": 1,
      "kind": "stat",
      "query": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
      "required_metrics": [
        "kube_node_status_condition"
      ],
      "title": "Ready Nodes",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "cluster",
      "id": 2,
      "kind": "stat",
      "query": "count(kube_node_info)",
      "required_metrics": [
        "kube_node_info"
      ],
      "title": "Total Nodes",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "workloads",
      "id": 3,
      "kind": "stat",
      "query": "sum(kube_pod_status_ready{condition=\"false\"})",
      "required_metrics": [
        "kube_pod_status_ready"
      ],
      "title": "Not-Ready Pods",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "workloads",
      "id": 4,
      "kind": "stat",
      "query": "sum(increase(kube_pod_container_status_restarts_total[1h]))",
      "required_metrics": [
        "kube_pod_container_status_restarts_total"
      ],
      "title": "Container Restarts (1h)",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "fluent_bit",
      "id": 5,
      "kind": "stat",
      "query": "count(up{job=~\".*fluent.*bit.*\"} == 1)",
      "required_metrics": [
        "up"
      ],
      "title": "Fluent Bit Ready Targets",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "workloads",
      "id": 6,
      "kind": "stat",
      "query": "sum(kube_deployment_status_replicas_unavailable)",
      "required_metrics": [
        "kube_deployment_status_replicas_unavailable"
      ],
      "title": "Unavailable Deployment Replicas",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "nodes",
      "id": 7,
      "kind": "timeseries",
      "query": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
      "required_metrics": [
        "node_cpu_seconds_total"
      ],
      "title": "Node CPU Utilization",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "nodes",
      "id": 8,
      "kind": "timeseries",
      "query": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
      "required_metrics": [
        "node_memory_MemAvailable_bytes",
        "node_memory_MemTotal_bytes"
      ],
      "title": "Node Memory Utilization",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "fluent_bit",
      "id": 9,
      "kind": "timeseries",
      "query": "sum(rate(fluentbit_input_records_total[5m]))",
      "required_metrics": [
        "fluentbit_input_records_total"
      ],
      "title": "Fluent Bit Input Records",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "fluent_bit",
      "id": 10,
      "kind": "timeseries",
      "query": "sum(rate(fluentbit_output_proc_records_total[5m]))",
      "required_metrics": [
        "fluentbit_output_proc_records_total"
      ],
      "title": "Fluent Bit Output Records",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "fluent_bit",
      "id": 11,
      "kind": "timeseries",
      "query": "sum(rate(fluentbit_output_errors_total[5m]))",
      "required_metrics": [
        "fluentbit_output_errors_total"
      ],
      "title": "Fluent Bit Output Errors",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "fluent_bit",
      "id": 12,
      "kind": "timeseries",
      "query": "sum(rate(fluentbit_output_retries_total[5m]))",
      "required_metrics": [
        "fluentbit_output_retries_total"
      ],
      "title": "Fluent Bit Output Retries",
      "validation_stage": "live-result-required"
    },
    {
      "datasource_uid": "loki",
      "family": "logs",
      "id": 13,
      "kind": "logs",
      "query": "{namespace=~\".+\"}",
      "required_metrics": [],
      "title": "Recent Cluster Logs",
      "validation_stage": "live-query-required"
    },
    {
      "datasource_uid": "prometheus",
      "family": "longhorn",
      "id": 14,
      "kind": "stat",
      "query": "100 * sum(longhorn_node_storage_usage_bytes) / sum(longhorn_node_storage_capacity_bytes)",
      "required_metrics": [
        "longhorn_node_storage_usage_bytes",
        "longhorn_node_storage_capacity_bytes"
      ],
      "title": "Longhorn Storage Utilization",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "longhorn",
      "id": 15,
      "kind": "timeseries",
      "query": "sum by (volume) (longhorn_volume_actual_size_bytes)",
      "required_metrics": [
        "longhorn_volume_actual_size_bytes"
      ],
      "title": "Longhorn Volume Actual Size",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "longhorn",
      "id": 16,
      "kind": "timeseries",
      "query": "sum by (volume) (longhorn_volume_write_throughput)",
      "required_metrics": [
        "longhorn_volume_write_throughput"
      ],
      "title": "Longhorn Volume Write Throughput",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "kubecost",
      "id": 17,
      "kind": "stat",
      "query": "sum(node_total_hourly_cost)",
      "required_metrics": [
        "node_total_hourly_cost"
      ],
      "title": "Kubecost Node Hourly Cost",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "kubecost",
      "id": 18,
      "kind": "stat",
      "query": "sum(kubecost_cluster_management_cost)",
      "required_metrics": [
        "kubecost_cluster_management_cost"
      ],
      "title": "Kubecost Management Hourly Cost",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "kubecost",
      "id": 19,
      "kind": "timeseries",
      "query": "sum by (namespace) (container_cpu_allocation)",
      "required_metrics": [
        "container_cpu_allocation"
      ],
      "title": "Kubecost CPU Allocation",
      "validation_stage": "syntax-only-before-activation"
    },
    {
      "datasource_uid": "prometheus",
      "family": "kubecost",
      "id": 20,
      "kind": "timeseries",
      "query": "sum by (namespace) (container_memory_allocation_bytes) / 1024^3",
      "required_metrics": [
        "container_memory_allocation_bytes"
      ],
      "title": "Kubecost Memory Allocation",
      "validation_stage": "syntax-only-before-activation"
    }
  ],
