
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-loki
  namespace: "{{ centralized_logging_namespace }}"
  labels:
    grafana_datasource: "1"
data:
  loki-datasource.yaml: |
    apiVersion: 1
    datasources:
      - name: Loki
        uid: loki
        type: loki
        access: proxy
        url: >-
          http://loki-gateway.{{ centralized_logging_namespace }}.svc.cluster.local
        isDefault: false
        editable: false
        jsonData:
          timeout: 60
          maxLines: 1000
