apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  failurePolicy: reinstall
  valuesContent: |-
    service:
      spec:
        loadBalancerIP: {{ traefik_load_balancer_ip }}
        externalTrafficPolicy: Local
      annotations:
        metallb.io/address-pool: {{ metallb_pool_name }}
