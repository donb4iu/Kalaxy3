# OpenWebUI deployment manifest
apiVersion: v1
kind: Namespace
metadata:
  name: openwebui
  labels:
    app.kubernetes.io/name: openwebui
    app.kubernetes.io/part-of: kalaxy3
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: openwebui-data
  namespace: openwebui
  labels:
    app.kubernetes.io/name: openwebui
    app.kubernetes.io/part-of: kalaxy3
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: longhorn
  resources:
    requests:
      storage: 10Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openwebui
  namespace: openwebui
  labels:
    app.kubernetes.io/name: openwebui
    app.kubernetes.io/part-of: kalaxy3
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: openwebui
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openwebui
        app.kubernetes.io/part-of: kalaxy3
    spec:
      containers:
        - name: openwebui
          image: ghcr.io/open-webui/open-webui:v0.11.3
          imagePullPolicy: IfNotPresent
          env:
            - name: OLLAMA_BASE_URL
              value: http://ollama.ollama.svc.cluster.local:11434
          ports:
            - containerPort: 8080
              name: http
          volumeMounts:
            - name: openwebui-data
              mountPath: /app/backend/data
          readinessProbe:
            httpGet:
              path: /health/db
              port: http
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
      volumes:
        - name: openwebui-data
          persistentVolumeClaim:
            claimName: openwebui-data
---
apiVersion: v1
kind: Service
metadata:
  name: openwebui
  namespace: openwebui
  labels:
    app.kubernetes.io/name: openwebui
    app.kubernetes.io/part-of: kalaxy3
  annotations:
    metallb.io/address-pool: lan-pool
spec:
  type: LoadBalancer
  selector:
    app.kubernetes.io/name: openwebui
  ports:
    - port: 80
      targetPort: http
      protocol: TCP
      name: http
