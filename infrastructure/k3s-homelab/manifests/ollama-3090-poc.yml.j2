---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ollama-3090-poc-models
  namespace: ollama
  labels:
    app.kubernetes.io/name: ollama-3090-poc
    app.kubernetes.io/part-of: kalaxy3
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: longhorn
  resources:
    requests:
      storage: 60Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ollama-3090-poc
  namespace: ollama
  labels:
    app.kubernetes.io/name: ollama-3090-poc
    app.kubernetes.io/part-of: kalaxy3
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ollama-3090-poc
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ollama-3090-poc
        app.kubernetes.io/part-of: kalaxy3
    spec:
      runtimeClassName: nvidia
      nodeSelector:
        kubernetes.io/hostname: amd64-01
        kubernetes.io/arch: amd64
        kalaxy3.io/gpu-capable: "true"
        kalaxy3.io/gpu-model: rtx-3090
      containers:
        - name: ollama
          image: "{{ kalaxy3_ollama_lock.image.reference }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: OLLAMA_HOST
              value: "0.0.0.0:11434"
          ports:
            - name: http
              containerPort: 11434
              protocol: TCP
          resources:
            requests:
              cpu: "1"
              memory: 4Gi
            limits:
              nvidia.com/gpu: 1
              memory: 32Gi
          readinessProbe:
            httpGet:
              path: /api/tags
              port: http
            initialDelaySeconds: 3
            periodSeconds: 5
            failureThreshold: 12
          startupProbe:
            httpGet:
              path: /api/version
              port: http
            periodSeconds: 5
            failureThreshold: 60
          volumeMounts:
            - name: models
              mountPath: /root/.ollama
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: ollama-3090-poc-models
---
apiVersion: v1
kind: Service
metadata:
  name: ollama-3090-poc
  namespace: ollama
  labels:
    app.kubernetes.io/name: ollama-3090-poc
    app.kubernetes.io/part-of: kalaxy3
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: ollama-3090-poc
  ports:
    - name: http
      port: 11434
      targetPort: http
      protocol: TCP
