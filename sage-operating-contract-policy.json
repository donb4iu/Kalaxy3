{
    "schema_version": "1.0",
    "policy_id": "kalaxy3-sage-operating-contract",
    "policy_version": "1.1.0",
    "status": "root-enforcement-staged",
    "standard_path": "markdown/standards/kalaxy3-sage-operating-contract.md",
    "contracts": {
        "authority_reconciliation": "markdown/standards/sage-authority-reconciliation-schema-v1.0.json",
        "component_selection_manifest": "markdown/standards/sage-component-selection-manifest-schema-v1.0.json",
        "capability_gap_receipt": "markdown/standards/sage-capability-gap-receipt-schema-v1.0.json",
        "failure_diagnosis": "markdown/standards/sage-failure-diagnosis-schema-v1.0.json",
        "operator_git_proposal": "markdown/standards/sage-operator-git-proposal-schema-v1.0.json",
        "outcome_metrics": "markdown/standards/sage-outcome-metrics-schema-v1.0.json"
    },
    "mandatory_sequence": [
        "preserve-literal-request",
        "collect-current-authority",
        "reconcile-authority",
        "declare-required-capabilities",
        "select-repository-owned-components",
        "record-composition-manifest",
        "record-capability-gaps",
        "implement-with-least-authority",
        "validate-real-runtime-path",
        "diagnose-unexpected-failures",
        "propose-one-operator-mutation-boundary",
        "verify-boundary-result",
        "record-outcomes-and-trends",
        "publish-sage-evidence"
    ],
    "authority_policy": {
        "required_authority_types": [
            "operator-intent",
            "git",
            "github",
            "repository-policy",
            "sage"
        ],
        "conditional_authority_types": [
            "runtime",
            "telemetry",
            "economics",
            "external-contract"
        ],
        "source_assertions_separate_from_inference": true,
        "material_conflicts_block_mutation": true,
        "stale_material_authority_blocks_mutation": true,
        "unknown_values_remain_explicit": true,
        "required_reconciliation_primitive": "authority.reconcile"
    },
    "component_policy": {
        "repository_owned_first": true,
        "versioned_interfaces_required": true,
        "selection_manifest_required": true,
        "capability_gap_receipt_before_new_primitive": true,
        "opaque_composite_ranking_forbidden": true,
        "selection_factors": [
            "applicability",
            "authority-compatibility",
            "least-sufficient-mutation-scope",
            "published-interface",
            "observed-successes",
            "observed-failures",
            "open-recurrence",
            "evidence-supported-maturity",
            "runtime-test-coverage",
            "credential-and-history-safety"
        ],
        "wrapper_only_root_cause_patch_forbidden": true,
        "required_selection_primitive": "component.select",
        "required_gap_primitive": "capability.gap"
    },
    "helper_policy": {
        "repository_content_edit_allowed": true,
        "validation_allowed": true,
        "read_only_git_inspection_allowed": true,
        "git_mutation_allowed": false,
        "github_mutation_allowed": false,
        "deployment_mutation_allowed": false,
        "personal_credentials_in_generated_code_allowed": false,
        "atomic_write_required": true,
        "preserve_existing_file_mode_required": true,
        "rollback_on_validation_failure_required": true,
        "local_event_log_allowed": true,
        "local_closeout_allowed": true,
        "forbidden_git_actions": [
            "branch-create",
            "branch-switch",
            "add",
            "commit",
            "push",
            "fetch",
            "pull",
            "merge",
            "rebase",
            "reset",
            "clean",
            "tag",
            "update-ref",
            "delete-ref"
        ],
        "required_git_primitive": "git.inspect",
        "restricted_git_primitive": "git.repository",
        "restricted_git_primitive_scope": "isolated-temporary-repository-tests"
    },
    "validation_policy": {
        "source_only_required": true,
        "operator_runtime_required_when_material": true,
        "positive_tests_required": true,
        "negative_tests_required": true,
        "semantic_outcome_required": true,
        "exact_path_to_mutation_boundary_required": true,
        "transaction_rollback_test_required": true,
        "syntax_only_is_sufficient": false,
        "root_guardrail_required": true
    },
    "failure_policy": {
        "diagnosis_before_retry": true,
        "failure_retrieval_before_retry": true,
        "what_failed_required": true,
        "what_should_have_happened_required": true,
        "expected_component_required": true,
        "actual_component_required": true,
        "divergence_reason_required": true,
        "ownership_required": true,
        "reusable_correction_or_no_action_required": true,
        "second_same_class_failure_requires_control": true,
        "required_diagnosis_primitive": "failure.diagnose"
    },
    "operator_mutation_policy": {
        "operator_executed": true,
        "one_boundary_at_a_time": true,
        "one_command_per_proposal": true,
        "pasted_complete_output_required": true,
        "read_only_post_verification_required": true,
        "next_boundary_blocked_until_verified": true,
        "helper_execution_of_proposed_command_forbidden": true,
        "root_composition_required": true,
        "bounded_routine_git_lifecycle_allowed": true,
        "routine_git_lifecycle_boundary": "routine-git-lifecycle",
        "routine_git_lifecycle_actions": [
            "stage",
            "commit",
            "push"
        ],
        "routine_git_lifecycle_requires_exact_authority": true
    },
    "metrics_policy": {
        "raw_before_derived": true,
        "unknown_is_null": true,
        "unmeasured_zero_forbidden": true,
        "authoritative_and_fixture_git_mutations_separate": true,
        "semantic_false_pass_measured": true,
        "operator_intervention_measured": true,
        "comparable_workflow_class_required_for_trend": true,
        "composite_score_enabled": false,
        "required_raw_metrics": [
            "workflows_started",
            "workflows_completed",
            "first_pass_completions",
            "semantic_validations",
            "semantic_false_passes",
            "commands_executed",
            "commands_failed",
            "commands_retried",
            "manual_corrections",
            "operator_interventions",
            "authority_checks",
            "authority_failures",
            "component_candidates_considered",
            "components_selected",
            "components_reused",
            "new_components_created",
            "component_contract_mismatches",
            "direct_execution_violations",
            "known_failures_encountered",
            "known_failures_recurred",
            "mutation_opportunities",
            "failures_detected_pre_mutation",
            "authoritative_repository_git_mutations",
            "disposable_fixture_git_mutations",
            "github_mutations",
            "deployment_mutations",
            "avoidable_rework_minutes",
            "prompt_to_validated_change_minutes"
        ],
        "required_derived_metrics": [
            "first_pass_completion_rate",
            "semantic_false_pass_rate",
            "component_reuse_ratio",
            "authority_failure_rate",
            "known_failure_recurrence_rate",
            "pre_mutation_detection_rate",
            "manual_correction_rate",
            "operator_intervention_rate"
        ],
        "primitive": "metrics.outcome@1.0.0",
        "baseline_report": "markdown/evidence-artifacts/SAGE-K3-OPERATING-CONTRACT-20260801-001/outcome-metrics-baseline.json",
        "formula_contract": {
            "first_pass_completion_rate": "first_pass_completions / workflows_completed",
            "semantic_false_pass_rate": "semantic_false_passes / semantic_validations",
            "component_reuse_ratio": "components_reused / components_selected",
            "authority_failure_rate": "authority_failures / authority_checks",
            "known_failure_recurrence_rate": "known_failures_recurred / known_failures_encountered",
            "pre_mutation_detection_rate": "failures_detected_pre_mutation / mutation_opportunities",
            "manual_correction_rate": "manual_corrections / (commands_executed + manual_corrections)",
            "operator_intervention_rate": "operator_interventions / (commands_executed + operator_interventions)"
        }
    },
    "activation_policy": {
        "current_state": "staged-root-enforcement",
        "deployment_authorized": false,
        "autonomous_mutation_authorized": false,
        "remaining_phases": [
            "evidence-publication"
        ],
        "completed_phases": [
            "policy-and-schema",
            "least-authority-safety-foundations",
            "decision-and-diagnosis-primitives",
            "semantic-outcome-measurement",
            "root-enforcement"
        ],
        "foundation_primitives": [
            "git.inspect@1.0.0",
            "file.atomic-preserve-mode@1.0.0",
            "operator.git-proposal@1.0.0",
            "git.safety-guardrail@1.0.0"
        ],
        "decision_primitives": [
            "authority.reconcile@1.0.0",
            "component.select@1.0.0",
            "capability.gap@1.0.0",
            "failure.diagnose@1.0.0"
        ],
        "measurement_primitives": [
            "metrics.outcome@1.0.0"
        ],
        "root_enforcement": {
            "composition": "scripts/sage/workflows/operating_contract.py",
            "self_test": "scripts/sage/sage-operating-contract-self-test.py",
            "guardrail": "scripts/sage/sage-operating-contract-guardrail.py",
            "make_target": "sage-operating-contract-check",
            "component_manifest": "markdown/evidence-artifacts/SAGE-K3-OPERATING-CONTRACT-20260801-001/component-selection-root-enforcement.json",
            "readiness_receipt": "markdown/evidence-artifacts/SAGE-K3-OPERATING-CONTRACT-20260801-001/root-enforcement-readiness.json"
        },
        "evidence_publication_mode": "split"
    },
    "trusted_operator_controller_policy": {
        "routine_git_lifecycle_path": "scripts/sage/workflows/routine_git_lifecycle.py",
        "operator_approval_required": true,
        "allowed_git_primitive": "git.repository",
        "allowed_git_methods": [
            "commit_and_push"
        ],
        "feature_branch_only": true,
        "exact_declared_paths_required": true,
        "expected_head_required": true,
        "remote_main_must_match_base_head": true,
        "github_mutation_allowed": false,
        "deployment_mutation_allowed": false,
        "credential_inheritance_allowed": false,
        "direct_git_command_allowed": false,
        "helper_execution_allowed": false,
        "read_only_post_verification_required": true
    }
,
  "objective_path_decision_policy": {
    "enabled": true,
    "decision_authority": "architect",
    "environment_variable": "SAGE_OBJECTIVE_PATH_DECISION",
    "required_decision_dimensions": [
      "who",
      "what",
      "why",
      "when",
      "where",
      "how",
      "classification",
      "deferral_consequence",
      "next_value_milestone"
    ],
    "allowed_classifications": [
      "direct-objective-value",
      "necessary-blocker-material-risk",
      "deferrable-sage-internal-improvement"
    ],
    "mutation_allowed_classifications": [
      "direct-objective-value",
      "necessary-blocker-material-risk"
    ],
    "deferrable_internal_improvement_may_mutate": false,
    "binding": [
      "exact-literal-request-sha256",
      "exact-proposal-package-sha256"
    ],
    "approval_basis": "operator-supplied-to-governed-execution"
  }
}
