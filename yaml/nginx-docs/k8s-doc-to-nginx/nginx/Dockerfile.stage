# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS stage

RUN apt-get update \
    && apt-get install -y --no-install-recommends git make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY requirements-docs.txt requirements-docs.lock.txt ./
RUN python3 -m venv /opt/kalaxy3-mkdocs \
    && /opt/kalaxy3-mkdocs/bin/python -m pip install --no-cache-dir -r requirements-docs.lock.txt \
    && touch /opt/kalaxy3-mkdocs/.kalaxy3-ready

COPY . .
RUN make sage-stage-guardrails
RUN make MKDOCS_VENV=/opt/kalaxy3-mkdocs docs-mkdocs-publication-test

FROM nginx AS runtime
ARG SAGE_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/donb4iu/Kalaxy3" \
      org.opencontainers.image.revision="${SAGE_SOURCE_SHA}" \
      io.kalaxy3.sage.stage-contract="portable-stage-v1"
COPY --from=stage /workspace/.mkdocs-work/publication-test/docs/ /usr/share/nginx/html/
