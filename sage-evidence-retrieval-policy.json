{
  "schema_version": "1.0",
  "algorithm_version": "deterministic-token-overlap-v2",
  "default_limit": 10,
  "minimum_score": 3,
  "allowed_dispositions": [
    "pending",
    "applied",
    "reviewed-not-applicable",
    "rejected",
    "requires-revalidation"
  ],
  "validated_status_values": [
    "accepted",
    "closed",
    "completed",
    "published",
    "validated"
  ],
  "source_weights": {
    "evidence": 4,
    "lesson": 5,
    "failure": 5,
    "improvement_action": 3,
    "post_session_review": 2
  },
  "field_weights": {
    "identifier": 2,
    "title": 7,
    "subject": 6,
    "tags": 5,
    "summary": 4,
    "status": 1,
    "body": 1
  },
  "stopwords": [
    "a",
