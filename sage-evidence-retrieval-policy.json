    "kalaxy3",
    "of",
    "on",
    "operations",
    "or",
    "repository",
    "repository-provisioned",
    "shows",
    "that",
    "the",
    "this",
    "to",
    "whether",
    "with"
  ],
  "term_groups": {
    "grafana": [
      "grafana",
      "dashboard",
      "dashboards",
      "panel",
      "panels",
      "visualization"
    ],
    "prometheus": [
      "prometheus",
      "metric",
