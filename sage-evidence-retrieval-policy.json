      "fluent",
      "collector"
    ],
    "storage": [
      "longhorn",
      "storage",
      "volume",
      "volumes",
      "pvc",
      "persistent"
    ],
    "kubecost": [
      "kubecost",
      "finops",
      "allocation"
    ],
    "validation": [
      "validation",
      "validated",
      "runtime",
      "health",
      "healthy",
      "guardrail",
      "audit"
    ],
    "evidence": [
      "evidence",
      "lesson",
      "lessons",
      "failure",
      "failures",
      "decision",
      "decisions",
      "experience"
    ]
  },
  "sources": [
    {
      "path": "markdown/evidence/catalog.json",
      "source_type": "evidence"
    },
    {
      "path": "sage-lessons.json",
      "source_type": "lesson"
    },
    {
      "path": "sage-actionable-failures.json",
      "source_type": "failure"
    },
    {
      "path": "sage-improvement-actions.json",
      "source_type": "improvement_action"
    },
    {
      "path": "sage-post-session-review-registry.json",
      "source_type": "post_session_review"
    }
  ],
  "minimum_matched_terms": 1,
  "quality_fields": {
    "maximum_applicable_facts": 5,
    "confidence_missing_value": "not-recorded",
    "recency_policy": "explicit-source-fields-only; relevance-score-first; recency-descending-tie-breaker"
  },
  "reconsideration_contract": {
    "schema_version": "1.0",
    "applicability_values": [
      "pending",
      "applicable",
      "partially-applicable",
      "contextually-relevant-not-applicable",
      "requires-revalidation",
      "superseded-for-context"
    ],
    "value_effect_values": [
      "pending",
      "strengthen",
      "weaken",
      "redirect",
      "expand",
      "no-material-effect",
      "requires-revalidation"
    ],
    "alternative_effect_values": [
      "pending",
      "none",
      "reuse",
      "augment",
      "replace",
      "coexist",
      "add-to-alternative-set"
    ],
    "reconsideration_trigger_required_for": [
      "contextually-relevant-not-applicable",
      "requires-revalidation",
      "superseded-for-context"
    ]
  }
}
