{
  "$schema": "markdown/standards/sage-capability-intelligence-schema-v1.0.json",
  "schema_version": "1.0",
  "model_id": "kalaxy3-sage-capability-intelligence",
  "policy": {
    "mission": "Make Kalaxy3 LLM-driven capability mutation more effective, predictable, reproducible, less costly, and less error-prone through federated authority, reusable engineering experience, visible alternatives, and measured outcomes.",
    "principles": [
      "SAGE is a decision partner, not the sole authority.",
      "The preferred target is explicit, versioned, and evolvable.",
      "Repository, runtime, telemetry, economics, and history remain separate.",
      "Immaturity reduces certainty without obscuring other dimensions.",
      "No opaque composite score may hide unknowns or blockers.",
      "Predictions are immutable, staged, and scalar-neutral.",
      "Rebuild-forward continuity protects outcomes, not exact replay.",
      "Autonomy is earned and delegated by domain."
    ],
    "dimensions": [
      "functional-outcome",
      "runtime-health",
      "telemetry-visibility",
      "evidence-confidence",
      "rebuild-forward-readiness",
      "security-assurance",
      "operational-maturity",
      "cost-efficiency"
    ],
    "dimension_statuses": [
      "unknown",
      "not-applicable",
      "blocked",
      "absent",
      "partial",
      "at-target",
      "exceeds-target"
    ],
    "war_pillars": [
      "operational-excellence",
      "security",
      "reliability",
      "performance-efficiency",
      "cost-optimization",
      "sustainability"
    ],
    "caf_perspectives": [
      "business",
      "people",
      "governance",
      "platform",
      "security",
      "operations"
    ],
    "composite_score_enabled": false,
    "maximum_current_autonomy": 2,
    "blocking_rules": [
      "required persistent state has no recovery or migration path",
      "bootstrap requires the capability it is intended to create",
      "required live state exists only through undocumented manual mutation",
      "a critical capability changes without validation and recovery authority",
      "protected values are published",
      "active mutation authorities conflict"
    ],
    "rebuild_forward": {
      "exact_topology_required": false,
      "exact_historical_sequence_required": false,
      "allowed_dispositions": [
        "preserve",
        "migrate",
        "replace",
        "consolidate",
        "retire"
      ]
    },
    "prediction": {
      "immutable_pre_outcome": true,
      "stages": [
        "discovery",
        "pre-deployment"
      ],
      "scalar_neutral": true,
      "actual_subject_and_unit_must_match": true,
      "unavailable_actual_is_null_and_inconclusive": true,
      "shirt_sizes": {
        "XS": "<4h",
        "S": "4-12h",
        "M": "12-32h",
        "L": "32-80h",
        "XL": ">80h; decompose"
      }
    }
  },
